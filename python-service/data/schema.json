{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MY_AI Interview Feedback Dataset",
  "description": "A dataset file is an array of interview conversation and human-reviewed feedback examples.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "conversation",
      "feedback"
    ],
    "additionalProperties": false,
    "properties": {
      "conversation": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "assistant",
                "user"
              ],
              "description": "Use assistant for interviewer messages and user for candidate messages."
            },
            "content": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "feedback": {
        "type": "object",
        "required": [
          "rating",
          "summary",
          "recommendation",
          "recommendationMessage",
          "strengths",
          "improvements",
          "technicalAssessment",
          "communicationAssessment",
          "overallConfidence"
        ],
        "additionalProperties": false,
        "properties": {
          "rating": {
            "type": "object",
            "required": [
              "relevance",
              "technicalDepth",
              "clarity",
              "communicationQuality"
            ],
            "additionalProperties": false,
            "properties": {
              "relevance": {
                "$ref": "#/$defs/rating"
              },
              "technicalDepth": {
                "$ref": "#/$defs/rating"
              },
              "clarity": {
                "$ref": "#/$defs/rating"
              },
              "communicationQuality": {
                "$ref": "#/$defs/rating"
              }
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "Yes",
              "No",
              "Maybe"
            ]
          },
          "recommendationMessage": {
            "type": "string",
            "minLength": 1
          },
          "strengths": {
            "$ref": "#/$defs/textList"
          },
          "improvements": {
            "$ref": "#/$defs/textList"
          },
          "technicalAssessment": {
            "type": "string",
            "minLength": 1
          },
          "communicationAssessment": {
            "type": "string",
            "minLength": 1
          },
          "overallConfidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    }
  },
  "$defs": {
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "textList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
